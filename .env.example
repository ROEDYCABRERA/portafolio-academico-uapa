# Required for the Supabase browser, server, and session clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional: use the v0-provided auth redirect proxy when running in v0.
# For local development, the app falls back to the current origin's /auth/callback.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
